# ============================================================
# STRONILEAD — variáveis de ambiente
# ============================================================
# Copie para .env.local (NÃO commitar). No Vercel, configure as
# mesmas chaves em Project Settings → Environment Variables.

# ---- Firebase Web (frontend / Vite) --------------------------------
# Valores PÚBLICOS (embarcam no bundle). Opcionais: o app cai nos
# valores do projeto crm-stronix se não definidos (ver src/lib/firebase.js).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin SDK (backend / pasta api/) ---------------------
# SECRETOS. Usados pelas serverless functions (api/_firebaseAdmin.js).
# A private key deve manter os \n escapados (uma linha só, entre aspas).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Asaas (gateway de cobrança recorrente / backend) --------------
# SECRETOS — só no backend, NUNCA no bundle. Sem ASAAS_API_KEY, a integração
# fica desligada (a UI mostra "não configurado" e a cobrança manual segue).
# Sandbox: chave com prefixo $aact_hmlg_ + base de sandbox abaixo.
# Produção: troque para a chave $aact_prod_ e ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_USER_AGENT=stronilead-crm
# Segredo do webhook (32–255 chars, sem espaços). DEVE ser igual ao authToken
# cadastrado no webhook do Asaas — o handler valida o header asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

# ---- Sentry (monitoramento de erro) --------------------------------
# Sem VITE_SENTRY_DSN o Sentry NÃO inicializa e o app sobe igual a antes.
# É o botão de desligar: remova a variável na Vercel e redeploye.
# O DSN é público por natureza (embarca no bundle), não é segredo.
VITE_SENTRY_DSN=

# Backend (funções api/). DSN do MESMO projeto no Sentry.
SENTRY_DSN=

# Opcional. O ambiente sai sozinho do VERCEL_ENV; isto só sobrescreve,
# para build fora da Vercel. Valores: production | preview | development
VITE_SENTRY_ENVIRONMENT=

# Só no build, para subir o source map e o stack trace vir legível.
# SEGREDO (dá acesso de escrita à conta do Sentry). Sem o token o plugin
# nem carrega e o build segue normal.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Firebase App Check (atestação do app) -------------------------
# Site key do reCAPTCHA Enterprise, criada no Google Cloud e registrada no
# console do Firebase. Valor PÚBLICO (embarca no bundle).
# Sem esta chave o App Check NÃO sobe e o app funciona igual a antes.
# Passo a passo completo em docs/APPCHECK_SETUP.md.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Só para ambiente local. Gere o token pelo console do navegador na primeira
# execução em dev e registre-o no console do Firebase, em App Check → Apps →
# Manage debug tokens. Sem isso, no dia em que o bloqueio for ligado, o
# `npm run dev` para de conversar com o Firebase.
VITE_APPCHECK_DEBUG_TOKEN=
